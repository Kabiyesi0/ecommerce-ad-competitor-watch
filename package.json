{
  "name": "competitor-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spike": "tsx --env-file=.env.local scripts/spike/run-spike.ts",
    "spike:summary": "tsx scripts/spike/summarize-cost.ts",
    "compare-models": "tsx --env-file=.env.local scripts/spike/compare-models.ts",
    "compare-models:all": "tsx scripts/spike/compare-models-all.ts",
    "test-provider-keys": "tsx --env-file=.env.local scripts/spike/test-provider-keys.ts",
    "check-stores": "tsx scripts/spike/check-stores.ts",
    "check-ad-library": "tsx scripts/spike/check-ad-library.ts",
    "generate-report-fixture": "tsx --env-file=.env.local scripts/spike/generate-report-fixture.ts",
    "measure-ad-hit-rate": "tsx scripts/spike/measure-ad-hit-rate.ts",
    "regenerate-moves": "tsx --env-file=.env.local scripts/spike/regenerate-moves.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/integration/golden-set.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cheerio": "^1.0.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "undici": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.5"
  }
}
