# The app's default flow is free mode (docs/decisions/007-free-mode.md)
# and needs none of the keys below. Set AI_MODE=on only to run the
# dormant AI pipeline locally (classify/search/pick competitors + moves).
# Off (default) means no code path may construct an Anthropic client —
# see src/lib/ai-mode.ts. NEVER set AI_MODE or ANTHROPIC_API_KEY in a
# deployed (e.g. Vercel) environment.
AI_MODE=
ANTHROPIC_API_KEY=
# Needed only for the model-provider comparison (scripts/spike/compare-models.ts).
# Leave blank to skip that provider — the comparison runs with whichever
# of these are present.
ZAI_API_KEY=
CEREBRAS_API_KEY=
# Optional override if Cerebras's current Llama model id differs from the
# default in src/llm/providers/llama-cerebras.ts (catalog shifts over time).
CEREBRAS_MODEL_ID=
